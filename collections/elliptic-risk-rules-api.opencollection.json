{
  "opencollection": "1.0.0",
  "info": {
    "name": "AML API OAuth Assets Risk Rules API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.elliptic.co/authorize",
      "accessTokenUrl": "https://login.elliptic.co/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Risk Rules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get team's risk rules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aml-api.elliptic.co/v2/risk_rules",
            "params": [
              {
                "name": "include_id_map",
                "value": "",
                "type": "query",
                "description": "Whether or not to include an id_map in response"
              }
            ]
          },
          "docs": "Get the risk rules for your team"
        }
      ]
    }
  ],
  "bundled": true
}