{
  "opencollection": "1.0.0",
  "info": {
    "name": "AML API OAuth Assets Criteria API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.elliptic.co/authorize",
      "accessTokenUrl": "https://login.elliptic.co/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Criteria",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all current categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://aml-api.elliptic.co/v2/criteria/categories"
          },
          "docs": "Get all current categories"
        }
      ]
    }
  ],
  "bundled": true
}